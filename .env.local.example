# ── Bókun booking widget ──
# Both values are already baked into lib/bokun.ts and are not secrets (they
# appear in the widget's public URL). Set these only to point the site at a
# different booking channel or product — e.g. a Bókun test channel.
#   CHANNEL_UUID = booking channel from the Bókun dashboard
#   HUNTER_VALLEY_PRODUCT_ID = the one product sold online (1269452)
# Private tours are enquiry-only and have no product ID.
# NEXT_PUBLIC_BOKUN_CHANNEL_UUID=
# NEXT_PUBLIC_BOKUN_HUNTER_VALLEY_PRODUCT_ID=

# ── Firebase client SDK (browser; used for Admin Auth login) ──
# From Firebase Console → Project settings → Your apps → Web app config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin SDK (server only) ──
# The FULL service-account JSON on a single line. From Firebase Console →
# Project settings → Service accounts → Generate new private key.
# Example: {"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n", ...}
FIREBASE_SERVICE_ACCOUNT=

# ── Admin allowlist ──
# Comma-separated emails allowed into /admin and admin API routes.
ADMIN_EMAILS=you@example.com

# ── Email notifications (Resend) — optional ──
# If unset, enquiries are still saved; only the emails are skipped.
# ENQUIRY_TO_EMAIL is the business/Jimmy inbox (enquiry + confirmation notices).
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=bookings@gourmetgetaway.example
ENQUIRY_FROM_EMAIL=Gourmet Getaway <noreply@gourmetgetaway.example>

# Public site origin, used for links and the calendar invite.
NEXT_PUBLIC_SITE_URL=https://gourmetgetaway.example
